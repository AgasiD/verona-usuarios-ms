{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations":  [
        {
            "command": "npm run start",
            "name": "Development",
            "request": "launch",
            "type": "node-terminal"
        },
        {
            "command": "npm run prepro",
            "name": "Prepro",
            "request": "launch",
            "type": "node-terminal"
        },
        {
            "command": "npm run start:prod",
            "name": "Production",
            "request": "launch",
            "type": "node-terminal"
        },
        {
            "type": "pwa-node",
            "request": "launch",
            "name": "Launch Program",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}/app.js"
        }
    ]
}